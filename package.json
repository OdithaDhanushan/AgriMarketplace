{
  "name": "agrimarketplace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run start -- --host lan --port 8084\"",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run start -- --host lan --port 8084",
    "install:all": "npm install --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
